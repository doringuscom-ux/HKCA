    "responses": {
      "en": {
        "hkca.about": [
          {
            "answer": "HKCA stands for Haryana Kayaking and Canoeing Association. We are the official state body dedicated to promoting and developing the sports of Kayaking and Canoeing in Haryana. We are affiliated with the Indian Kayaking and Canoeing Association and the Haryana Olympic Association."
          }
        ],
        "hkca.work": [
          {
            "answer": "HKCA organizes state-level tournaments, training camps, and selection trials for athletes. We identify talent, provide professional coaching, and prepare athletes for national and international competitions like the Olympics and Asian Games."
          }
        ],
        "hkca.join": [
          {
            "answer": "You can join HKCA by registering as an athlete, coach, or club on our website. Go to the \"Register\" section, fill in your details, and upload the required documents. Once verified by the admin, you will become an official member."
          }
        ],
        "hkca.contact": [
          {
            "answer": "You can contact us via the Contact page on our website or visit our head office in Haryana. You can also send an inquiry through the contact form, and our team will get back to you."
          }
        ],
        "hkca.president": [
          {
            "answer": "Capt. Jaswinder Meenu Beniwal is the President of HKCA. His message to the athletes: \"I extend my heartfelt greetings to all athletes of Haryana. Our mission is to promote kayaking and canoeing across the state and reach every aspiring sportsperson at the grassroots level. I encourage all young athletes to take up water sports with dedication and confidence. We are committed to providing the necessary opportunities, training, and support.\""
          }
        ],
        "hkca.affiliation": [
          {
            "answer": "Yes, HKCA is proudly affiliated with the Indian Kayaking and Canoeing Association (IKCA) and the Haryana Olympic Association (HOA). We work closely with these bodies to promote the sport as an Olympic discipline."
          }
        ],
        "hkca.events.list": [
          {
            "answer": "Here are the latest ongoing and upcoming events directly from our official portal. Choose an event below to see its details, dates, and registration info!"
          }
        ],
        "hkca.how_to_register": [
          {
            "answer": "Registering on HKCA is simple: 1. Click \"Join the Association\" or go to the Register page. 2. Step 1: Create your Account with username, email, and choose your role (Athlete, Coach, or Club). 3. Step 2: Fill in your basic personal details. 4. Step 3: Review and click \"Complete Registration\". After this, you will be redirected to your Profile to add documents."
          }
        ],
        "hkca.how_to_edit_profile": [
          {
            "answer": "To update your details: 1. Login to your account. 2. Go to the \"Profile\" page from the menu. 3. Click the \"Edit Profile\" button. 4. Change your contact info or upload new documents. 5. Click \"Save Changes\". Note: Some personal details are locked once the Admin verifies your profile."
          }
        ],
        "hkca.verification": [
          {
            "answer": "After you complete your profile and upload documents (Aadhaar, Photo, etc.), the HKCA Admin will review your application. This usually takes 2-3 working days. Once verified, a green badge will appear on your profile, and you can register for championships."
          }
        ],
        "greetings.hello": [
          {
            "answer": "Hello! How can I help you today with HKCA related queries?"
          },
          {
            "answer": "Hi there! I am your HKCA Assistant. What would you like to know?"
          },
          {
            "answer": "Namaste! How can I assist you with HKCA information?"
          }
        ],
        "hkca.events.upcoming_request": [
          {
            "answer": "Here are the upcoming HKCA events. Click on any name to see its full details, fees, and registration deadline:"
          }
        ],
        "hkca.events.completed_request": [
          {
            "answer": "Here are the recently completed events and championship results:"
          }
        ],
        "event_69d339070db21ae87fc4cf48": [
          {
            "answer": "9th Haryana State Dragon boat Championship, 2026 is scheduled for 15/5/2026 at Sector 5, Panchkula. Fees: Athlete ₹200, Coach ₹500, Club ₹10000. Registration Requirements: You need a Verified Profile with your Photograph and Date of Birth Proof. Description: The 9th Haryana State Dragon Boat Championship, 2026 is a state-level water sports event where teams compete in synchronized dragon boat races over various distances such as 200m, 500m, and 1000m. It brings together paddlers from different districts of Haryana to showcase teamwork, coordination, and endurance.\r\n\r\nOrganized to promote traditional and modern water sports, the championship helps identify talented athletes for national-level competitions and encourages the growth of dragon boat racing, a fast-paced team sport requiring rhythm and unity."
          }
        ],
        "event_69d339090db21ae87fc4cf4a": [
          {
            "answer": "21st Haryana State Kayaking and Canoeing Championship, 2026   is scheduled for 7/5/2026 at Sector 5, Panchkula. Fees: Athlete ₹200, Coach ₹500, Club ₹10000. Registration Requirements: You need a Verified Profile with your Photograph and Date of Birth Proof. Description: The 21st Haryana State Kayaking and Canoeing Championship, 2026 is a state-level water sports competition held in Haryana, where athletes compete in various kayaking and canoeing events. Organized under the guidance of bodies like the Indian Kayaking and Canoeing Association, the championship provides a platform for players to showcase their skills in races such as sprint, marathon, and team events.\r\n\r\nIt aims to promote water sports in the state, identify talented paddlers, and prepare athletes for national and international competitions."
          }
        ],
        "event_69d3390a0db21ae87fc4cf4c": [
          {
            "answer": "Junior Athletics Meet is scheduled for 10/7/2026 at Rajiv Gandhi Sports Complex, Rohtak. Fees: Athlete ₹200, Coach ₹500, Club ₹500. Registration Requirements: You need a Verified Profile with your Photograph and Date of Birth Proof. Description: A platform for young athletes to showcase their speed and agility in various track and field events."
          }
        ],
        "news_69d741924afd756223422f9f": [
          {
            "answer": "Latest News: State Championship 2024: Official Winners List. Summary: Congratulations to all the podium finishers of the HKCA State Championship. Detailed results inside.. Category: Results"
          }
        ],
        "news_69d741924afd756223422fa2": [
          {
            "answer": "Latest News: National Trials: Haryana Athletes Dominate Results. Summary: Haryana's paddlers have secured top positions in the recent national trials held in Bhopal. Outstanding performance by all.. Category: Results"
          }
        ],
        "news_69de1341abbc6af66f25952d": [
          {
            "answer": "Latest News: 36th National Canoe Sprint . Summary: 36th National Canoe Sprint Junior & Sub-Junior Men & Women Championships. Category: News"
          }
        ],
        "hkca.events.upcoming": [
          {
            "answer": "Currently, we have two exciting upcoming events. Which one would you like details about?"
          }
        ],
        "hkca.events.completed": [
          {
            "answer": "Our completed events include the 2023 Senior State Championship and the District level selection trials. You can check the \"Results\" or \"Gallery\" page to see the winner lists and photos from these past events!"
          }
        ],
        "hkca.awards": [
          {
            "answer": "Winners in official state championships receive Gold, Silver, and Bronze medals along with Merit Certificates authorized by HKCA. All participating athletes also receive a Digital Participation Certificate directly available in their dashboard."
          }
        ],
        "hkca.developer": [
          {
            "answer": "This platform and I (the HKCA Smart Assistant) were built by an expert development team to make the entire HKCA ecosystem digital, transparent, and user-friendly for all athletes of Haryana!"
          }
        ],
        "hkca.sports_info": [
          {
